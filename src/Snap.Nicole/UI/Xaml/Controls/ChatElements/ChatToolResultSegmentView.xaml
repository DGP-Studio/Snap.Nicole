<UserControl
    x:Class="Snap.Nicole.UI.Xaml.Controls.ChatElements.ChatToolResultSegmentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:snsawsp="using:Snap.Nicole.Services.AI.Agent.Workspace.StructuredPatch"
    xmlns:snsao="using:Snap.Nicole.Services.AI.Observables"
    xmlns:snsaobt="using:Snap.Nicole.Services.AI.Observables.BuiltInTools"
    xmlns:snuxcc="using:Snap.Nicole.UI.Xaml.Controls.ChatElements"
    xmlns:snuxd="using:Snap.Nicole.UI.Xaml.Data">

    <UserControl.Resources>
        <snuxd:EmptyObjectToVisibilityConverter x:Key="ContentVisibilityConverter" />
        <snuxcc:ChatEditToolHunkLineKindToObjectConverter
            x:Key="EditLineBackgroundBrushConverter"
            AdditionValue="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
            DeletionValue="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
        <snuxcc:ChatWriteToolResultTypeToObjectConverter
            x:Key="WriteTypeTextConverter"
            CreateValue="创建"
            UpdateValue="更新" />

        <DataTemplate x:Key="FunctionToolResultTemplate" x:DataType="snsao:ObservableFunctionResultContent">
            <Border
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Glyph="&#xEC7A;" />
                    <FontIcon
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Glyph="&#xE76B;" />
                    <TextBlock
                        Grid.Column="2"
                        Opacity="0.7"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding Result}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="EditToolResultTemplate" x:DataType="snsaobt:ObservableEditToolResultContent">
            <Border
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Glyph="&#xEC7A;" />
                        <FontIcon
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Glyph="&#xE70F;" />
                        <TextBlock
                            Grid.Column="2"
                            Opacity="0.7"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{Binding FilePath}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="3"
                            Opacity="0.7"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{Binding ChangeSummary}" />
                    </Grid>

                    <TextBlock
                        Opacity="0.7"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding Result}"
                        TextWrapping="WrapWholeWords" />

                    <ScrollViewer
                        MaxHeight="400"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Auto">
                        <ItemsControl
                            Margin="4"
                            ItemsSource="{Binding EditResult.StructuredPatch}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="snsawsp:AgentWorkspaceStructuredPatchHunk">
                                    <ItemsControl ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="snsawsp:AgentWorkspaceStructuredPatchHunkLine">
                                                <Border
                                                    Padding="4,1"
                                                    Background="{Binding Kind, Converter={StaticResource EditLineBackgroundBrushConverter}}">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock
                                                            MinWidth="42"
                                                            HorizontalAlignment="Right"
                                                            FontFamily="Cascadia Code, Consolas, Courier New"
                                                            FontSize="13"
                                                            IsTextSelectionEnabled="True"
                                                            Opacity="0.55"
                                                            Text="{Binding Line}"
                                                            TextWrapping="NoWrap" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontFamily="Cascadia Code, Consolas, Courier New"
                                                            FontSize="13"
                                                            IsTextSelectionEnabled="True"
                                                            Text="{Binding Text}"
                                                            TextWrapping="NoWrap" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GlobToolResultTemplate" x:DataType="snsaobt:ObservableGlobToolResultContent">
            <Border
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Glyph="&#xEC7A;" />
                        <FontIcon
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Glyph="&#xE721;" />
                        <TextBlock
                            Grid.Column="2"
                            Opacity="0.7"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{Binding CallId}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="3"
                            Opacity="0.7"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{Binding Summary}" />
                    </Grid>

                    <ScrollViewer
                        MaxHeight="280"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Auto"
                        Visibility="{Binding FileNames, Converter={StaticResource ContentVisibilityConverter}}">
                        <ItemsControl
                            Margin="4"
                            ItemsSource="{Binding FileNames}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontFamily="Cascadia Code, Consolas, Courier New"
                                        FontSize="13"
                                        IsTextSelectionEnabled="True"
                                        Text="{Binding}"
                                        TextWrapping="NoWrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GrepToolResultTemplate" x:DataType="snsaobt:ObservableGrepToolResultContent">
            <Border
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Glyph="&#xEC7A;" />
                        <FontIcon
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Glyph="&#xE721;" />
                        <TextBlock
                            Grid.Column="2"
                            Opacity="0.7"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{Binding ResultLabel}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="3"
                            Opacity="0.7"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{Binding Summary}" />
                    </Grid>

                    <ScrollViewer
                        MaxHeight="320"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Auto"
                        Visibility="{Binding Lines, Converter={StaticResource ContentVisibilityConverter}}">
                        <ItemsControl
                            Margin="4"
                            ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontFamily="Cascadia Code, Consolas, Courier New"
                                        FontSize="13"
                                        IsTextSelectionEnabled="True"
                                        Text="{Binding}"
                                        TextWrapping="NoWrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ReadToolResultTemplate" x:DataType="snsaobt:ObservableReadToolResultContent">
            <Border
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Glyph="&#xEC7A;" />
                    <FontIcon
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Glyph="&#xE8A5;" />
                    <TextBlock
                        Grid.Column="2"
                        Opacity="0.7"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding FilePath}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="3"
                        Opacity="0.7"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding Summary}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="WriteToolResultTemplate" x:DataType="snsaobt:ObservableWriteToolResultContent">
            <Border
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Glyph="&#xEC7A;" />
                        <FontIcon
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Glyph="&#xE74E;" />
                        <TextBlock
                            Grid.Column="2"
                            Opacity="0.7"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{Binding FilePath}"
                            TextTrimming="CharacterEllipsis" />
                        <StackPanel
                            Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="4">
                            <TextBlock
                                Opacity="0.7"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{Binding WriteResult.Type, Converter={StaticResource WriteTypeTextConverter}}" />
                            <TextBlock
                                Opacity="0.7"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{Binding ChangeSummary}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Opacity="0.7"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding Result}"
                        TextWrapping="WrapWholeWords" />

                    <ScrollViewer
                        MaxHeight="400"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Auto">
                        <ItemsControl
                            Margin="4"
                            ItemsSource="{Binding WriteResult.StructuredPatch}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="snsawsp:AgentWorkspaceStructuredPatchHunk">
                                    <ItemsControl ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="snsawsp:AgentWorkspaceStructuredPatchHunkLine">
                                                <Border
                                                    Padding="4,1"
                                                    Background="{Binding Kind, Converter={StaticResource EditLineBackgroundBrushConverter}}">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock
                                                            MinWidth="42"
                                                            HorizontalAlignment="Right"
                                                            FontFamily="Cascadia Code, Consolas, Courier New"
                                                            FontSize="13"
                                                            IsTextSelectionEnabled="True"
                                                            Opacity="0.55"
                                                            Text="{Binding Line}"
                                                            TextWrapping="NoWrap" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontFamily="Cascadia Code, Consolas, Courier New"
                                                            FontSize="13"
                                                            IsTextSelectionEnabled="True"
                                                            Text="{Binding Text}"
                                                            TextWrapping="NoWrap" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ContentCollectionToolResultTemplate">
            <Border
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Glyph="&#xEC7A;" />
                        <FontIcon
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Glyph="&#xE76B;" />
                        <TextBlock
                            Grid.Column="2"
                            Opacity="0.7"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{Binding CallId}"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Outputs}" Visibility="{Binding Outputs, Converter={StaticResource ContentVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <snuxcc:ChatObjectSegmentView Value="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FallbackToolResultTemplate" x:DataType="snsao:ObservableToolResultContent">
            <Border
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Glyph="&#xEC7A;" />
                    <FontIcon
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Glyph="&#xE76B;" />
                    <TextBlock
                        Grid.Column="2"
                        Opacity="0.7"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Text="{Binding CallId}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </DataTemplate>

        <snuxcc:ChatToolResultTemplateSelector
            x:Key="ToolResultTemplateSelector"
            CodeInterpreterTemplate="{StaticResource ContentCollectionToolResultTemplate}"
            EditTemplate="{StaticResource EditToolResultTemplate}"
            FallbackTemplate="{StaticResource FallbackToolResultTemplate}"
            FunctionTemplate="{StaticResource FunctionToolResultTemplate}"
            GlobTemplate="{StaticResource GlobToolResultTemplate}"
            GrepTemplate="{StaticResource GrepToolResultTemplate}"
            ImageGenerationTemplate="{StaticResource ContentCollectionToolResultTemplate}"
            McpServerTemplate="{StaticResource ContentCollectionToolResultTemplate}"
            ReadTemplate="{StaticResource ReadToolResultTemplate}"
            WebSearchTemplate="{StaticResource ContentCollectionToolResultTemplate}"
            WriteTemplate="{StaticResource WriteToolResultTemplate}" />
    </UserControl.Resources>

    <ContentControl
        HorizontalContentAlignment="Stretch"
        Content="{x:Bind ToolResult, Mode=OneWay}"
        ContentTemplateSelector="{StaticResource ToolResultTemplateSelector}" />
</UserControl>
