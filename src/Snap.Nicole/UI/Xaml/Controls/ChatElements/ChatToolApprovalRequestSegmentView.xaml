<UserControl
    x:Class="Snap.Nicole.UI.Xaml.Controls.ChatElements.ChatToolApprovalRequestSegmentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwc="using:CommunityToolkit.WinUI.Converters"
    xmlns:snuxd="using:Snap.Nicole.UI.Xaml.Data"
    xmlns:snuxm="using:Snap.Nicole.UI.Xaml.Markup"
    x:Name="Root">

    <UserControl.Resources>
        <cwc:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <snuxd:EmptyStringToVisibilityConverter x:Key="ArgumentsVisibilityConverter" />
    </UserControl.Resources>

    <Border
        Padding="8"
        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource ControlCornerRadius}">
        <StackPanel Spacing="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Glyph="&#xE72E;" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{snuxm:StringResource Name=UIXamlControlsChatToolApprovalRequestSegmentViewLabelTitle}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{Binding ToolApprovalRequest.StateDisplay.Value, ElementName=Root}" />
            </Grid>

            <StackPanel Spacing="2">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{Binding ToolApprovalRequest.ToolName, ElementName=Root}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Opacity="0.7"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="{Binding ToolApprovalRequest.ToolArguments, ElementName=Root}"
                    TextWrapping="WrapWholeWords"
                    Visibility="{Binding ToolApprovalRequest.ToolArguments, ElementName=Root, Converter={StaticResource ArgumentsVisibilityConverter}}" />
            </StackPanel>

            <StackPanel
                Orientation="Horizontal"
                Spacing="6"
                Visibility="{Binding ToolApprovalRequest.CanRespond, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button
                    Command="{Binding ToolApprovalRequest.ApproveCommand, ElementName=Root}"
                    CommandParameter="{Binding ToolApprovalRequest, ElementName=Root}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE73E;" />
                        <TextBlock Text="{snuxm:StringResource Name=UIXamlControlsChatToolApprovalRequestSegmentViewLabelAllow}" />
                    </StackPanel>
                </Button>
                <Button
                    Command="{Binding ToolApprovalRequest.DenyCommand, ElementName=Root}"
                    CommandParameter="{Binding ToolApprovalRequest, ElementName=Root}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                        <TextBlock Text="{snuxm:StringResource Name=UIXamlControlsChatToolApprovalRequestSegmentViewLabelDeny}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
