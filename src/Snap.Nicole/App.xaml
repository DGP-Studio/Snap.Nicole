<Application
    x:Class="Snap.Nicole.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cwm="using:CommunityToolkit.WinUI.Media">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!--  Other merged dictionaries here  -->
                <ResourceDictionary Source="ms-appx:///UI/Xaml/Themes/Pivot.xaml" />
                <ResourceDictionary Source="ms-appx:///UI/Xaml/Themes/TransitionCollections.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <x:Double x:Key="CompatShadowThemeOpacity">0.14</x:Double>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <x:Double x:Key="CompatShadowThemeOpacity">0.28</x:Double>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!--  Other app resources here  -->

            <!--  Page Transparent Background  -->
            <StaticResource x:Key="ApplicationPageBackgroundThemeBrush" ResourceKey="ControlFillColorTransparentBrush" />

            <!--  Modify Window title bar color  -->
            <StaticResource x:Key="WindowCaptionBackground" ResourceKey="ControlFillColorTransparentBrush" />
            <StaticResource x:Key="WindowCaptionBackgroundDisabled" ResourceKey="ControlFillColorTransparentBrush" />

            <cwm:AttachedCardShadow
                x:Key="CompatCardShadow"
                BlurRadius="8"
                Opacity="{ThemeResource CompatShadowThemeOpacity}"
                Offset="0,4,0" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
